{
  "name": "ticker-tape-web",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "budget": "bash scripts/bundle_budget.sh",
    "probe": "python3 scripts/probe_gate.py",
    "build:tailnet": "bash scripts/deploy_tailnet.sh",
    "dev:tv": "vite --config vite.tv.config.js",
    "build:tv": "vite build --config vite.tv.config.js",
    "package:tv": "bash scripts/tizen_tv.sh",
    "test:full": "node test/run-tests.mjs --full",
    "test:fast": "node test/run-tests.mjs --fast",
    "test:local": "node test/run-tests.mjs --full --pool=vmThreads --vmMemoryLimit=512MB --exclude=test/lib/private_font_build.test.js --exclude=test/worker/security_log.test.js && vitest run --pool=forks test/lib/private_font_build.test.js test/worker/security_log.test.js",
    "build:ios": "node scripts/build-ios.mjs",
    "ios:sync": "npm run build:ios && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@preact/preset-vite": "^2.10.5",
    "@tailwindcss/vite": "^4.2.2",
    "flag-icons": "^7.5.0",
    "lightweight-charts": "^5.1.0",
    "linkedom": "^0.18.13",
    "preact": "^10.29.4",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@csstools/postcss-cascade-layers": "^6.0.2",
    "@csstools/postcss-is-pseudo-class": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.4",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.26",
    "vitest": "^4.1.4"
  }
}
