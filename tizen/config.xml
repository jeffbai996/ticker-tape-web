<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/jeffbai996/ticker-tape-web/tv"
        version="1.0.0"
        viewmodes="maximized">
  <tizen:application id="TickrTape1.TickerTapeTV"
                     package="TickrTape1"
                     required_version="4.0"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <icon src="icon.png"/>
  <name>Ticker Tape</name>
  <description>Market board for Samsung TVs: watchlist, markets, chart and wire headlines.</description>
  <tizen:profile name="tv-samsung"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable"
                 background-support="disable" encryption="disable"
                 install-location="auto" hwkey-event="enable"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <!-- Public Yahoo data through the Worker, the price stream, and fonts. -->
  <access origin="*" subdomains="true"/>
</widget>
